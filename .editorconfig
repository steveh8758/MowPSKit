root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{json,md,txt}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[.gitattributes]
end_of_line = lf

[.gitignore]
end_of_line = lf

[.editorconfig]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
